<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*_32.png">
      <LogicalName>SolidsFromPolylines.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Reference Include="acdbmgd">
      <HintPath>..\library\references\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>..\library\references\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>..\library\references\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>..\library\references\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>..\library\references\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="PackageCivil3DAddinBundle" AfterTargets="Build">
    <PropertyGroup>
      <Civil3DBundleDir>$(TargetDir)SolidsFromPolylines.bundle</Civil3DBundleDir>
    </PropertyGroup>
    <MakeDir Directories="$(Civil3DBundleDir)\Contents\Windows" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(Civil3DBundleDir)\Contents\Windows\SolidsFromPolylines.dll" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\PackageContents.xml"
      DestinationFiles="$(Civil3DBundleDir)\PackageContents.xml" />
  </Target>
</Project>
